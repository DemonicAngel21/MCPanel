{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPanel",
  "mainBinaryName": "MCPanel",
  "version": "0.1.0",
  "identifier": "io.github.mcpanel.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MCPanel",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://cdn.modrinth.com https://hangarcdn.papermc.io",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "The MCPanel Contributors",
    "copyright": "Copyright (c) 2026 The MCPanel Contributors. MIT OR Apache-2.0.",
    "category": "Utility",
    "shortDescription": "Desktop control panel for local Minecraft Java servers",
    "longDescription": "MCPanel manages local Minecraft Java servers: create, start, stop, console, files and configuration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
