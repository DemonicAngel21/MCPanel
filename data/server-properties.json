{
  "$comment": "server.properties schema. 'since' = first version with this definition, 'until' = first version WITHOUT it (exclusive). Omitted = applies to all versions. Version ordering comes from the Mojang manifest. For servers that have already generated server.properties, the file itself defines which keys exist; this schema only supplies metadata.",
  "version": 1,
  "properties": [
    { "key": "motd", "type": "text", "default": "A Minecraft Server", "category": "gameplay", "label": "Message of the day", "description": "Shown in the multiplayer server list. Supports \\n for a second line and § formatting codes." },
    { "key": "difficulty", "type": "enum", "values": ["peaceful", "easy", "normal", "hard"], "default": "easy", "category": "gameplay", "label": "Difficulty", "since": "1.14" },
    { "key": "difficulty", "type": "integer", "min": 0, "max": 3, "default": "1", "category": "gameplay", "label": "Difficulty", "description": "0 = peaceful, 1 = easy, 2 = normal, 3 = hard.", "until": "1.14" },
    { "key": "gamemode", "type": "enum", "values": ["survival", "creative", "adventure", "spectator"], "default": "survival", "category": "gameplay", "label": "Default game mode", "since": "1.14" },
    { "key": "gamemode", "type": "integer", "min": 0, "max": 3, "default": "0", "category": "gameplay", "label": "Default game mode", "description": "0 = survival, 1 = creative, 2 = adventure, 3 = spectator.", "until": "1.14" },
    { "key": "force-gamemode", "type": "boolean", "default": "false", "category": "gameplay", "label": "Force game mode", "description": "Players join in the default game mode every time." },
    { "key": "hardcore", "type": "boolean", "default": "false", "category": "gameplay", "label": "Hardcore", "description": "Players are set to spectator mode when they die." },
    { "key": "pvp", "type": "boolean", "default": "true", "category": "gameplay", "label": "PvP", "description": "Allow players to damage each other." },
    { "key": "max-players", "type": "integer", "min": 1, "max": 100000, "default": "20", "category": "gameplay", "label": "Max players" },
    { "key": "allow-flight", "type": "boolean", "default": "false", "category": "gameplay", "label": "Allow flight", "description": "Do not kick players who appear to fly in survival (needed by some plugins/mods)." },
    { "key": "spawn-monsters", "type": "boolean", "default": "true", "category": "gameplay", "label": "Spawn monsters" },
    { "key": "spawn-animals", "type": "boolean", "default": "true", "category": "gameplay", "label": "Spawn animals" },
    { "key": "spawn-npcs", "type": "boolean", "default": "true", "category": "gameplay", "label": "Spawn villagers" },
    { "key": "allow-nether", "type": "boolean", "default": "true", "category": "world", "label": "Allow the Nether" },
    { "key": "player-idle-timeout", "type": "integer", "min": 0, "max": 100000, "default": "0", "category": "gameplay", "label": "Idle kick (minutes)", "description": "0 disables idle kicking." },

    { "key": "level-name", "type": "string", "default": "world", "category": "world", "label": "World folder name", "description": "Folder containing the world. Changing it switches to a different world." },
    { "key": "level-seed", "type": "string", "default": "", "category": "world", "label": "World seed", "description": "Only used when the world is first generated. Empty = random." },
    { "key": "level-type", "type": "string", "default": "minecraft:normal", "suggestions": ["minecraft:normal", "minecraft:flat", "minecraft:large_biomes", "minecraft:amplified", "minecraft:single_biome_surface"], "category": "world", "label": "World type", "description": "Only used when the world is first generated.", "since": "1.19" },
    { "key": "level-type", "type": "string", "default": "default", "suggestions": ["default", "flat", "largeBiomes", "amplified"], "category": "world", "label": "World type", "description": "Only used when the world is first generated.", "until": "1.19" },
    { "key": "generator-settings", "type": "string", "default": "", "category": "world", "label": "Generator settings", "description": "Advanced world generator settings (format depends on the version)." },
    { "key": "generate-structures", "type": "boolean", "default": "true", "category": "world", "label": "Generate structures" },
    { "key": "max-world-size", "type": "integer", "min": 1, "max": 29999984, "default": "29999984", "category": "world", "label": "Max world radius" },
    { "key": "spawn-protection", "type": "integer", "min": 0, "max": 1000, "default": "16", "category": "world", "label": "Spawn protection radius", "description": "Non-operators cannot build within this radius of spawn. 0 disables." },
    { "key": "initial-enabled-packs", "type": "string", "default": "vanilla", "category": "world", "label": "Initial enabled packs", "since": "1.19.3" },
    { "key": "initial-disabled-packs", "type": "string", "default": "", "category": "world", "label": "Initial disabled packs", "since": "1.19.3" },
    { "key": "region-file-compression", "type": "enum", "values": ["deflate", "lz4", "none"], "default": "deflate", "category": "world", "label": "Region file compression", "since": "1.20.5" },

    { "key": "server-port", "type": "integer", "min": 1, "max": 65535, "default": "25565", "category": "network", "label": "Server port (TCP)" },
    { "key": "server-ip", "type": "string", "default": "", "category": "network", "label": "Bind address", "description": "Leave empty to listen on all interfaces." },
    { "key": "online-mode", "type": "boolean", "default": "true", "category": "security", "label": "Online mode", "description": "Verify accounts with Mojang/Microsoft. Disabling allows anyone to join with any name — only do this behind a proxy that authenticates players." },
    { "key": "network-compression-threshold", "type": "integer", "min": -1, "max": 65535, "default": "256", "category": "network", "label": "Compression threshold (bytes)", "description": "-1 disables compression." },
    { "key": "prevent-proxy-connections", "type": "boolean", "default": "false", "category": "network", "label": "Prevent proxy connections" },
    { "key": "use-native-transport", "type": "boolean", "default": "true", "category": "network", "label": "Native transport", "description": "Linux-only optimisation; has no effect on Windows." },
    { "key": "rate-limit", "type": "integer", "min": 0, "max": 100000, "default": "0", "category": "network", "label": "Packet rate limit", "since": "1.16" },
    { "key": "enable-status", "type": "boolean", "default": "true", "category": "network", "label": "Show in server list", "since": "1.16" },
    { "key": "hide-online-players", "type": "boolean", "default": "false", "category": "network", "label": "Hide online players", "since": "1.18" },
    { "key": "accepts-transfers", "type": "boolean", "default": "false", "category": "network", "label": "Accept transfers", "since": "1.20.5" },
    { "key": "enable-query", "type": "boolean", "default": "false", "category": "network", "label": "Enable query (UDP)" },
    { "key": "query.port", "type": "integer", "min": 1, "max": 65535, "default": "25565", "category": "network", "label": "Query port" },

    { "key": "white-list", "type": "boolean", "default": "false", "category": "security", "label": "Whitelist", "until": "26.3" },
    { "key": "white-list", "type": "boolean", "default": "true", "category": "security", "label": "Whitelist", "description": "Only players on the whitelist can join. New servers have it on since 26.3.", "since": "26.3" },
    { "key": "enforce-whitelist", "type": "boolean", "default": "false", "category": "security", "label": "Enforce whitelist", "description": "Kick players not on the whitelist when it is reloaded." },
    { "key": "enforce-secure-profile", "type": "boolean", "default": "true", "category": "security", "label": "Enforce secure chat profiles", "since": "1.19" },
    { "key": "op-permission-level", "type": "integer", "min": 0, "max": 4, "default": "4", "category": "security", "label": "Operator permission level" },
    { "key": "function-permission-level", "type": "integer", "min": 1, "max": 4, "default": "2", "category": "security", "label": "Function permission level", "since": "1.14" },
    { "key": "enable-command-block", "type": "boolean", "default": "false", "category": "security", "label": "Command blocks" },
    { "key": "log-ips", "type": "boolean", "default": "true", "category": "security", "label": "Log player IP addresses", "since": "1.20.2" },
    { "key": "enable-rcon", "type": "boolean", "default": "false", "category": "security", "label": "Enable RCON", "description": "Remote console over TCP. The protocol is not encrypted and binds to the server IP (all interfaces when empty). Keep disabled unless you need it." },
    { "key": "rcon.port", "type": "integer", "min": 1, "max": 65535, "default": "25575", "category": "security", "label": "RCON port" },
    { "key": "rcon.password", "type": "string", "default": "", "category": "security", "label": "RCON password", "sensitive": true },
    { "key": "broadcast-rcon-to-ops", "type": "boolean", "default": "true", "category": "security", "label": "Broadcast RCON to operators" },
    { "key": "management-server-enabled", "type": "boolean", "default": "false", "category": "security", "label": "Enable management server", "description": "Minecraft's JSON-RPC management API over WebSocket. Keep disabled unless you use a tool that needs it.", "since": "1.21.9" },
    { "key": "management-server-host", "type": "string", "default": "localhost", "category": "security", "label": "Management server host", "since": "1.21.9" },
    { "key": "management-server-port", "type": "integer", "min": 0, "max": 65535, "default": "0", "category": "security", "label": "Management server port", "since": "1.21.9" },
    { "key": "management-server-secret", "type": "string", "default": "", "category": "security", "label": "Management server secret", "description": "Generated by the server when empty.", "sensitive": true, "since": "1.21.9" },
    { "key": "management-server-tls-enabled", "type": "boolean", "default": "true", "category": "security", "label": "Management server TLS", "since": "1.21.9" },
    { "key": "management-server-tls-keystore", "type": "string", "default": "", "category": "security", "label": "Management server TLS keystore", "since": "1.21.9" },
    { "key": "management-server-tls-keystore-password", "type": "string", "default": "", "category": "security", "label": "Management server keystore password", "sensitive": true, "since": "1.21.9" },
    { "key": "broadcast-console-to-ops", "type": "boolean", "default": "true", "category": "security", "label": "Broadcast console to operators" },

    { "key": "view-distance", "type": "integer", "min": 2, "max": 32, "default": "10", "category": "performance", "label": "View distance (chunks)" },
    { "key": "simulation-distance", "type": "integer", "min": 2, "max": 32, "default": "10", "category": "performance", "label": "Simulation distance (chunks)", "since": "1.18" },
    { "key": "entity-broadcast-range-percentage", "type": "integer", "min": 10, "max": 1000, "default": "100", "category": "performance", "label": "Entity broadcast range (%)", "since": "1.16" },
    { "key": "max-tick-time", "type": "integer", "min": -1, "max": 2147483647, "default": "60000", "category": "performance", "label": "Watchdog max tick time (ms)", "description": "The server stops itself if a single tick takes longer. -1 disables the watchdog." },
    { "key": "sync-chunk-writes", "type": "boolean", "default": "true", "category": "performance", "label": "Synchronous chunk writes", "since": "1.16" },
    { "key": "max-chained-neighbor-updates", "type": "integer", "min": -1, "max": 2147483647, "default": "1000000", "category": "performance", "label": "Max chained neighbor updates", "since": "1.19" },
    { "key": "pause-when-empty-seconds", "type": "integer", "min": -1, "max": 2147483647, "default": "60", "category": "performance", "label": "Pause when empty (seconds)", "since": "1.21.2" },

    { "key": "resource-pack", "type": "string", "default": "", "category": "advanced", "label": "Resource pack URL" },
    { "key": "resource-pack-sha1", "type": "string", "default": "", "category": "advanced", "label": "Resource pack SHA-1" },
    { "key": "resource-pack-prompt", "type": "text", "default": "", "category": "advanced", "label": "Resource pack prompt", "since": "1.17" },
    { "key": "require-resource-pack", "type": "boolean", "default": "false", "category": "advanced", "label": "Require resource pack", "since": "1.17" },
    { "key": "enable-jmx-monitoring", "type": "boolean", "default": "false", "category": "advanced", "label": "JMX monitoring", "since": "1.16" },
    { "key": "bug-report-link", "type": "string", "default": "", "category": "advanced", "label": "Bug report link", "since": "1.21" },
    { "key": "snooper-enabled", "type": "boolean", "default": "true", "category": "advanced", "label": "Snooper", "until": "1.18" }
  ]
}
