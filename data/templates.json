      "memory_mb": { "min": 1024, "max": 4096 },
      "properties": [
        { "key": "white-list", "value": "true" },
        { "key": "enforce-whitelist", "value": "true" },
        { "key": "online-mode", "value": "true" },
        { "key": "max-players", "value": "10" },
        { "key": "spawn-protection", "value": "0" },
        { "key": "difficulty", "value": "normal", "since": "1.14" },
        { "key": "difficulty", "value": "2", "until": "1.14" }
      ],
      "backups": { "interval_minutes": 360 },
      "auto_restart": true,
      "plugins": []
    },
    {
      "id": "creative",
      "name": "Creative build world",
      "description": "A flat creative world without monsters or PvP — for building together.",
      "icon": "blocks",
      "software": ["paper", "purpur", "vanilla"],
      "memory_mb": { "min": 1024, "max": 3072 },
      "properties": [
        { "key": "gamemode", "value": "creative", "since": "1.14" },
        { "key": "gamemode", "value": "1", "until": "1.14" },
        { "key": "difficulty", "value": "peaceful", "since": "1.14" },
        { "key": "difficulty", "value": "0", "until": "1.14" },
        { "key": "level-type", "value": "minecraft:flat", "since": "1.19" },
        { "key": "level-type", "value": "flat", "until": "1.19" },
