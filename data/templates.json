        { "key": "spawn-monsters", "value": "false" },
        { "key": "pvp", "value": "false" },
        { "key": "allow-flight", "value": "true" }
      ],
      "backups": { "interval_minutes": 720 },
      "auto_restart": true,
      "plugins": []
    },
    {
      "id": "hardcore",
      "name": "Hardcore",
      "description": "One life on hard difficulty: players who die become spectators. Backed up every 3 hours.",
      "icon": "skull",
      "software": ["paper", "purpur", "vanilla"],
      "memory_mb": { "min": 1024, "max": 4096 },
      "properties": [
        { "key": "hardcore", "value": "true" },
        { "key": "difficulty", "value": "hard", "since": "1.14" },
        { "key": "difficulty", "value": "3", "until": "1.14" }
      ],
      "backups": { "interval_minutes": 180 },
      "auto_restart": true,
      "plugins": []
