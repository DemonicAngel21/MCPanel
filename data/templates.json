{
  "$comment": "Built-in server templates. 'software' lists preferred server software in order (the first one the user can install is used). Property entries use the same 'since'/'until' version ranges as server-properties.json; entries that do not apply to the chosen Minecraft version are skipped. 'plugins' are suggestions the user can deselect; they are only offered for software that supports plugins. Templates never contain JVM flags: the provider's recommended flags are used.",
  "version": 1,
  "templates": [
    {
      "id": "survival",
      "name": "Survival",
      "description": "Classic survival on normal difficulty, backed up every 6 hours and restarted automatically after a crash.",
      "icon": "trees",
      "software": ["paper", "purpur", "vanilla"],
      "memory_mb": { "min": 1024, "max": 4096 },
      "properties": [
        { "key": "difficulty", "value": "normal", "since": "1.14" },
        { "key": "difficulty", "value": "2", "until": "1.14" },
        { "key": "pvp", "value": "true" }
      ],
      "backups": { "interval_minutes": 360 },
      "auto_restart": true,
      "plugins": []
    },
    {
      "id": "friends",
      "name": "Friends only",
      "description": "A private server: only players on the whitelist can join. Add your friends on the Players tab after creating it.",
      "icon": "users",
